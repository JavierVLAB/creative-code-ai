# Credenciales del usuario de test para la suite E2E (Playwright).
# Copiar a .env.e2e (no versionado) y rellenar con un usuario real de Supabase.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# URL base del frontend corriendo en local (pnpm dev). Opcional, default http://localhost:5173
E2E_BASE_URL=http://localhost:5173
